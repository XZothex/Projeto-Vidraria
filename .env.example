# Copie este arquivo para ".env" e ajuste os valores. NUNCA envie o ".env" ao GitHub.

DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco: "sqlite" (desenvolvimento local) ou "postgresql" (definitivo)
DB_ENGINE=sqlite

# Usados apenas quando DB_ENGINE=postgresql
DB_NAME=vidraria
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
