# Copie este arquivo para ".env" e ajuste os valores. NUNCA envie o ".env" ao GitHub.

DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco Django: "sqlite", "postgresql" ou "mysql" (pedidos integrados ao estoque).
DB_ENGINE=sqlite

# Usados apenas quando DB_ENGINE=postgresql
DB_NAME=vidraria
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Banco MySQL do estoque (módulo movimentacoes): base estoque_vidracaria_v2, criada
# pelos scripts de banco/mysql/sql. O login do Django deve ser igual a usuario.login.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=seu_usuario
MYSQL_PASSWORD=
MYSQL_DATABASE=estoque_vidracaria_v2
